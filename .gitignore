# Global ignores
.history

# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example

# Logs
logs/
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime and generated files
uploads/
tmp/
temp/
coverage/
.cache/
dist/
build/
*.pid
*.pid.lock
*.local

# Test and tool caches
.vite
.eslintcache

# Editor directories and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =========================
# Client-specific ignores
# =========================
client/node_modules/
client/dist/
client/build/

# Environment files
client/.env
client/.env.*
!client/.env.example

# Logs
client/logs/
client/*.log

# Tool caches
client/.vite
client/.eslintcache

# =========================
# Server-specific ignores
# =========================
server/node_modules/
server/dist/
server/dist-ssr/

# Environment files
server/.env
server/.env.*
!server/.env.example

# Logs
server/logs/
server/*.log

# Tool caches
server/.vite
server/.eslintcache
